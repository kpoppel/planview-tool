{
  "manifest_version": 3,
  "name": "Planview Time Helper",
  "version": "0.1.0",
  "description": "Fill Planview time-reporting forms with local defaults.",
  "permissions": ["storage"],
  "host_permissions": ["https://date.nager.at/api/v3/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://wsa.pvcloud.com/planview/Track/Time/Report*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Planview Time Helper"
  }
}